+// scrcpy packets contain complete MediaCodec access units, not individual slices.
+function handleScrcpyPacket(data) {
+  if (!(data instanceof ArrayBuffer) || data.byteLength < 13 || data.byteLength > 2097164) return;
+  const header = new DataView(data);
+  if (header.getUint32(8) !== data.byteLength - 12) return;
+  const bytes = new Uint8Array(data);
+  const payload = bytes.subarray(12);
+  if (bytes[0] & 0x40) {
+    const units = splitNalUnits(payload);
+    const sps = units.find(unit => getNalType(unit) === 7);
+    const pps = units.find(unit => getNalType(unit) === 8);
+    if (!sps || !pps) return;
+    spsPps = appendByteArray(sps, pps);
+    configureDecoderFromSpsPps();
+    return;
+  }
