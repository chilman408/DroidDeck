+  if (!decoder || decoder.state !== "configured" || !spsPps) return;
+  if (!key && (dropDeltaUntilKeyframe || isDecodeBacklogged())) {
+    dropDeltaUntilKeyframe = true;
+    return;
+  }
+  const timestamp = (header.getUint32(0) & 0x1fffffff) * 4294967296 + header.getUint32(4);
+  if (!Number.isSafeInteger(timestamp)) return;
+  try {
+    decoder.decode(new EncodedVideoChunk({ type: key ? "key" : "delta", timestamp: timestamp,
+      data: key ? appendByteArray(spsPps, payload) : payload }));
+    if (key) dropDeltaUntilKeyframe = false;
+  } catch (error) {
+    dropDeltaUntilKeyframe = true;
+    self.postMessage({ error: String(error) });
+  }
+}
