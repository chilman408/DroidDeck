[Unit]
Description=DroidDeck original-owned GPU recovery %i
After=local-fs.target

[Service]
Type=notify
NotifyAccess=main
User=root
Group=root
WorkingDirectory=/
ExecStart=/usr/bin/python3 -B /var/lib/droiddeck/gpu-recovery/runtime/portable/fresh-gpu.py --watch %i
Restart=on-failure
RestartSec=5s
KillMode=control-group
TimeoutStartSec=30s
TimeoutStopSec=210s
UMask=0077

[Install]
WantedBy=multi-user.target
