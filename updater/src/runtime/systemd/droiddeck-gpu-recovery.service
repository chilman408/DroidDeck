[Unit]
Description=DroidDeck independent Android GPU recovery
After=local-fs.target
Before=waydroid-container.service tesla-waydroid-compositor.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/droiddeck/gpu-recovery/runtime/portable/gpu-activation.py --watch
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
KillMode=control-group

[Install]
WantedBy=multi-user.target
