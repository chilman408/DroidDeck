[Unit]
Description=DroidDeck single-use guarded Android GPU activation
Requires=droiddeck-gpu-recovery.service
After=droiddeck-gpu-recovery.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/droiddeck/gpu-recovery/runtime/portable/gpu-activation.py --activate
TimeoutStartSec=360
TimeoutStopSec=10
KillMode=control-group
